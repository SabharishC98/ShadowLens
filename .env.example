# ── LLM Provider API Keys (Free Tier) ─────────────────────────────────────────
# Gemini — Get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Groq — Get free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas (recommended):  mongodb+srv://user:pass@cluster.mongodb.net/shadowlens
# Local:                mongodb://localhost:27017/shadowlens
MONGODB_URI=mongodb://localhost:27017/shadowlens
MONGODB_DB=shadowlens

# ── Classifier ────────────────────────────────────────────────────────────────
# Path to fine-tuned DistilBERT checkpoint.
# Leave as "stub" to run without a trained model (returns dummy labels).
CLASSIFIER_MODEL_PATH=stub

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Default Models ────────────────────────────────────────────────────────────
# LiteLLM format: provider/model-name
# Gemini (free):  gemini/gemini-2.0-flash, gemini/gemini-1.5-flash
# Groq (free):    groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant
DEFAULT_PIPELINE_MODEL=gemini/gemini-2.0-flash
GOAL_CHECKER_MODEL=gemini/gemini-2.0-flash
RUNS_PER_CELL=20
MAX_CONCURRENCY=1
